<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Trim/AOT analyzers run on every build; the builders create nodes directly, with no reflection. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>OracleSqlParser.Fluent</PackageId>
    <!-- Versioned independently of the core library (stays 0.x while the API may still change); not tied to the release tag. -->
    <Version>0.1.0-preview.1</Version>
    <Authors>aklein53</Authors>
    <Description>Fluent builders that create and edit OracleSqlParser syntax trees (SELECT, INSERT, UPDATE, DELETE, MERGE and expressions), so that every built tree is the tree the parser produces for the printed SQL.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/aklein53/OracleSqlParser</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aklein53/OracleSqlParser</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>oracle;sql;parser;ast;builder;fluent</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RootNamespace>OracleSqlParser.Fluent</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="4.14.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.404" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OracleSqlParser\OracleSqlParser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
